    "Connect to the server to create today's journal note. Journals with week notes can't be added to offline." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل بالخادم لإنشاء ملاحظة يوميات اليوم. لا يمكن الإضافة دون اتصال إلى اليوميات التي تحتوي على ملاحظات أسبوعية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro vytvoření dnešní deníkové poznámky se připojte k serveru. Do deníků s týdenními poznámkami nelze přidávat offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden Sie sich mit dem Server, um die heutige Journalnotiz zu erstellen. Journale mit Wochennotizen können offline nicht ergänzt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to the server to create today's journal note. Journals with week notes can't be added to offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate al servidor para crear la nota del diario de hoy. Los diarios con notas semanales no se pueden ampliar sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous au serveur pour créer la note du journal d’aujourd’hui. Les journaux avec des notes de semaine ne peuvent pas être complétés hors ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज का जर्नल नोट बनाने के लिए सर्वर से कनेक्ट करें। साप्ताहिक नोट्स वाले जर्नल में ऑफ़लाइन नहीं जोड़ा जा सकता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakozz a kiszolgálóhoz a mai naplójegyzet létrehozásához. A heti jegyzeteket használó naplókhoz nem lehet offline hozzáadni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connettiti al server per creare la nota del diario di oggi. Ai diari con note settimanali non si possono aggiungere note offline."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz się z serwerem, aby utworzyć dzisiejszą notatkę dziennika. Do dzienników z notatkami tygodniowymi nie można dodawać offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключитесь к серверу, чтобы создать сегодняшнюю заметку журнала. В журналы с недельными заметками нельзя добавлять офлайн."
          }
        }
      }
    },
