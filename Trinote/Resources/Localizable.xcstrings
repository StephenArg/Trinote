    "Today's journal note is protected. Unlock protected notes in Trinote to add to it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة يوميات اليوم محمية. افتح قفل الملاحظات المحمية في Trinote للإضافة إليها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešní deníková poznámka je chráněná. Chcete-li do ní přidat text, odemkněte v Trinote chráněné poznámky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heutige Journalnotiz ist geschützt. Entsperre geschützte Notizen in Trinote, um etwas hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's journal note is protected. Unlock protected notes in Trinote to add to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota del diario de hoy está protegida. Desbloquea las notas protegidas en Trinote para añadirle texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La note du journal d’aujourd’hui est protégée. Déverrouillez les notes protégées dans Trinote pour y ajouter du texte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज का जर्नल नोट सुरक्षित है। इसमें जोड़ने के लिए Trinote में सुरक्षित नोट्स अनलॉक करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mai naplójegyzet védett. A hozzáadáshoz oldd fel a védett jegyzeteket a Trinote-ban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota del diario di oggi è protetta. Sblocca le note protette in Trinote per aggiungervi testo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzisiejsza notatka dziennika jest chroniona. Odblokuj chronione notatki w Trinote, aby coś do niej dodać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодняшняя заметка журнала защищена. Разблокируйте защищённые заметки в Trinote, чтобы добавить в неё текст."
          }
        }
      }
    },
