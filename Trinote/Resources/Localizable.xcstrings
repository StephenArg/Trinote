    "The Add Note tab then makes this kind of note without asking. Change it in Settings → Navigation Tabs." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستنشئ علامة تبويب إضافة ملاحظة هذا النوع من الملاحظات دون سؤال. غيّره من الإعدادات ← علامات تبويب التنقل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta Přidat poznámku pak vytvoří tento druh poznámky bez ptaní. Změníte to v Nastavení → Navigační karty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tab „Notiz hinzufügen“ erstellt dann diese Art Notiz ohne Nachfrage. Ändere es unter Einstellungen → Navigationstabs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Add Note tab then makes this kind of note without asking. Change it in Settings → Navigation Tabs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pestaña Añadir nota creará entonces este tipo de nota sin preguntar. Cámbialo en Ajustes → Pestañas de navegación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’onglet Ajouter une note créera ensuite ce type de note sans demander. Modifiez-le dans Réglages → Onglets de navigation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर नोट जोड़ें टैब बिना पूछे इसी प्रकार की नोट बनाएगा। इसे सेटिंग्स → नेविगेशन टैब में बदलें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Jegyzet hozzáadása fül ezután kérdés nélkül ilyen jegyzetet készít. Módosítás: Beállítások → Navigációs fülek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda Aggiungi nota creerà poi questo tipo di nota senza chiedere. Modificalo in Impostazioni → Schede di navigazione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta Dodaj notatkę będzie wtedy tworzyć ten rodzaj notatki bez pytania. Zmień to w Ustawienia → Karty nawigacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладка «Добавить заметку» будет создавать заметки этого вида без вопроса. Изменить: Настройки → Вкладки навигации."
          }
        }
      }
    },
    "The bar is full. Remove a tab to add another." : {
