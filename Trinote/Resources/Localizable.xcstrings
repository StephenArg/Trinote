    "You have an unsaved draft for this note. Would you like to restore it?" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد مسودة غير محفوظة. هل تريد استعادتها?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte neuložený koncept. Obnovit?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt einen ungespeicherten Entwurf. Wiederherstellen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have an unsaved draft for this note. Would you like to restore it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes un borrador sin guardar. ¿Quieres restaurarlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un brouillon non enregistré est présent. Voulez-vous le restaurer ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस नोट का असहेजा ड्राफ़्ट है। पुनर्स्थापित करें?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentetlen piszkozat van. Visszaállítja?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai una bozza non salvata. Vuoi ripristinarla?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz niezapisany szkic. Przywrócić?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть несохранённый черновик. Восстановить?"
          }
        }
      }
    },
    "You will need to re-enter your credentials to reconnect." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستحتاج إلى إعادة إدخال بيانات الاعتماد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro opětovné připojení zadejte znovu přihlašovací údaje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie müssen Ihre Anmeldedaten erneut eingeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will need to re-enter your credentials to reconnect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deberás volver a introducir tus credenciales para reconectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devrez saisir à nouveau vos identifiants."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुनः कनेक्ट करने के लिए क्रेडेंशियल दोबारा दर्ज करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Újra meg kell adnia a hitelesítő adatokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovrai reinserire le credenziali per riconnetterti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby ponownie się połączyć, wprowadź ponownie dane logowania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потребуется снова ввести учётные данные."
          }
        }
      }
    },
    "Your latest changes haven't reached the server yet, so the export would miss them. Try again once they've synced." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تصل أحدث تغييراتك إلى الخادم بعد، لذا لن يتضمنها التصدير. حاول مرة أخرى بعد مزامنتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše poslední změny ještě nedorazily na server, export by je tedy neobsahoval. Zkuste to znovu po synchronizaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre letzten Änderungen sind noch nicht auf dem Server, der Export würde sie also nicht enthalten. Versuchen Sie es nach der Synchronisierung erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your latest changes haven't reached the server yet, so the export would miss them. Try again once they've synced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus últimos cambios aún no han llegado al servidor, así que la exportación no los incluiría. Vuelve a intentarlo cuando se hayan sincronizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos dernières modifications n’ont pas encore atteint le serveur ; l’exportation ne les inclurait pas. Réessayez une fois qu’elles seront synchronisées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके हाल के बदलाव अभी सर्वर तक नहीं पहुँचे हैं, इसलिए निर्यात में वे नहीं आएँगे। सिंक होने के बाद फिर से कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legutóbbi módosításaid még nem értek el a kiszolgálóra, így az exportból kimaradnának. Próbáld újra, ha szinkronizálódtak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue ultime modifiche non hanno ancora raggiunto il server, quindi l’esportazione non le includerebbe. Riprova quando saranno sincronizzate."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje ostatnie zmiany nie dotarły jeszcze na serwer, więc eksport by ich nie zawierał. Spróbuj ponownie po synchronizacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последние изменения ещё не дошли до сервера, поэтому экспорт их не учтёт. Повторите попытку после синхронизации."
          }
        }
      }
    },
    "Your location couldn't be found right now. Try again in a moment." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر العثور على موقعك الآن. حاول مرة أخرى بعد قليل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši polohu se teď nepodařilo zjistit. Zkuste to za chvíli znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Standort konnte gerade nicht ermittelt werden. Versuchen Sie es gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location couldn't be found right now. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo encontrar tu ubicación ahora mismo. Vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position est introuvable pour le moment. Réessayez dans un instant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी आपका स्थान नहीं मिल सका। थोड़ी देर में फिर से कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyzeted most nem határozható meg. Próbáld újra egy kis idő múlva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile trovare la tua posizione in questo momento. Riprova tra poco."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się teraz ustalić Twojej lokalizacji. Spróbuj ponownie za chwilę."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось определить ваше местоположение. Повторите попытку чуть позже."
          }
        }
      }
    }
  },
  "version" : "1.1"
}