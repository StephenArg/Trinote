          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contenuto della nota verrà letto come testo formattato, quindi a capo e spaziature potrebbero andare persi al prossimo salvataggio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
