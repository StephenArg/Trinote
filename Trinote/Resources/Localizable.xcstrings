            "state" : "translated",
            "value" : "Ha csak a Jegyzetek látható, a fülsáv rejtve van. A Beállítások a Jegyzetek képernyő … menüjében található."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
