          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisano na tym urządzeniu. Zaloguj się ponownie w Trinote, a zostanie dodane do dziennika."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранено на этом устройстве. Войдите снова в Trinote, и текст будет добавлен в журнал."
          }
        }
      }
    },
