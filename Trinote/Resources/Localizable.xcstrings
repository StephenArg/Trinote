    "Autosave has already saved some of your edits. Discarding puts the note back the way it was when you started editing." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حفظ الحفظ التلقائي بعض تعديلاتك بالفعل. عند التجاهل تعود الملاحظة كما كانت عندما بدأت تحريرها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatické ukládání už část vašich úprav uložilo. Zahozením se poznámka vrátí do stavu, v jakém byla, když jste začali upravovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch speichern hat bereits einen Teil deiner Änderungen gespeichert. Beim Verwerfen wird die Notiz auf den Stand zurückgesetzt, den sie zu Beginn der Bearbeitung hatte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosave has already saved some of your edits. Discarding puts the note back the way it was when you started editing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El guardado automático ya guardó algunos de tus cambios. Al descartarlos, la nota vuelve a como estaba cuando empezaste a editarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement automatique a déjà enregistré une partie de vos modifications. Les ignorer remet la note dans l’état où elle était quand vous avez commencé à la modifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑटोसेव आपके कुछ बदलाव पहले ही सहेज चुका है। छोड़ने पर नोट वैसा ही हो जाएगा जैसा संपादन शुरू करते समय था।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az automatikus mentés már elmentette a módosításaid egy részét. Elvetésükkel a jegyzet visszaáll arra az állapotra, amilyen a szerkesztés kezdetekor volt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il salvataggio automatico ha già salvato alcune modifiche. Scartandole, la nota torna com’era quando hai iniziato a modificarla."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autozapis zapisał już część Twoich zmian. Odrzucenie przywróci notatkę do stanu sprzed rozpoczęcia edycji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автосохранение уже сохранило часть ваших изменений. Если их отменить, заметка вернётся к состоянию на момент начала редактирования."
          }
        }
      }
    },
    "Autosave saves your changes a few seconds after you stop typing, and when you leave the note, without closing the editor." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ الحفظ التلقائي تغييراتك بعد بضع ثوانٍ من توقفك عن الكتابة وعند مغادرة الملاحظة، دون إغلاق المحرر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatické ukládání uloží změny několik sekund poté, co přestanete psát, a při opuštění poznámky, aniž by zavřelo editor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch speichern sichert deine Änderungen ein paar Sekunden, nachdem du aufhörst zu tippen, und wenn du die Notiz verlässt, ohne den Editor zu schließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosave saves your changes a few seconds after you stop typing, and when you leave the note, without closing the editor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El guardado automático guarda tus cambios unos segundos después de que dejes de escribir y al salir de la nota, sin cerrar el editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement automatique enregistre vos modifications quelques secondes après que vous arrêtez d’écrire, ainsi qu’en quittant la note, sans fermer l’éditeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑटोसेव आपके टाइप करना बंद करने के कुछ सेकंड बाद और नोट छोड़ते समय आपके बदलाव सहेजता है, संपादक बंद किए बिना।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az automatikus mentés néhány másodperccel azután menti a változtatásaidat, hogy abbahagytad a gépelést, és amikor elhagyod a jegyzetet, a szerkesztő bezárása nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il salvataggio automatico salva le modifiche qualche secondo dopo che smetti di scrivere e quando esci dalla nota, senza chiudere l’editor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autozapis zapisuje zmiany kilka sekund po tym, jak przestaniesz pisać, oraz gdy opuszczasz notatkę, bez zamykania edytora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автосохранение сохраняет изменения через несколько секунд после того, как вы перестали печатать, и при выходе из заметки, не закрывая редактор."
          }
        }
      }
    },
