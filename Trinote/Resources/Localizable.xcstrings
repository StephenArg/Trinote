    "Remove %lld note(s) from Favorites? They will not be deleted from the server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %lld note(s) from Favorites? They will not be deleted from the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar %lld nota(s) de favoritos? No se eliminarán del servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere %lld nota(e) dai preferiti? Non verranno eliminate dal server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer %lld note(s) des favoris ? Elles ne seront pas supprimées du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Notiz(en) aus Favoriten entfernen? Auf dem Server bleiben sie erhalten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать %lld заметок из избранного? На сервере они не удаляются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة %lld ملاحظة من المفضلة؟ لن تُحذف من الخادم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld नोट पसंदीदा से हटाएँ? सर्वर से नहीं हटेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jegyzet eltávolítása a kedvencekből? A szerveren megmaradnak."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat %lld poznámek z oblíbených? Na serveru zůstanou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %lld notatek z ulubionych? Na serwerze pozostaną."
          }
        }
      }
    },
