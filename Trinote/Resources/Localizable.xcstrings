        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek a beállítások a Trilium-kiszolgálódon élnek (Beállítások → AI). A szolgáltatókat és API-kulcsaikat ott kezelheted."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste impostazioni risiedono sul tuo server Trilium (Opzioni → IA). I provider e le loro chiavi API si gestiscono lì."
          }
