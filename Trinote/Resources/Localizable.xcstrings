    "Unlock the note to preview matches in the body.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the note to preview matches in the body."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea la nota para previsualizar coincidencias en el cuerpo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca la nota per vedere le corrispondenze nel corpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez la note pour prévisualiser les correspondances dans le corps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie die Notiz, um Treffer im Inhalt in der Vorschau zu sehen."
