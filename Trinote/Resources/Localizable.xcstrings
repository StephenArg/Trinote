    "Hide Save Button removes the floating save button. To close the editor, use Save in the ⋯ menu or tap Back." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل خيار إخفاء زر الحفظ زر الحفظ العائم. لإغلاق المحرر، استخدم «حفظ» في القائمة ⋯ أو اضغط على رجوع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrýt tlačítko Uložit odstraní plovoucí tlačítko pro uložení. Editor zavřete volbou Uložit v nabídce ⋯ nebo klepnutím na Zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern-Taste ausblenden entfernt die schwebende Speichern-Taste. Zum Schließen des Editors nutze Speichern im ⋯-Menü oder tippe auf Zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide Save Button removes the floating save button. To close the editor, use Save in the ⋯ menu or tap Back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar botón Guardar quita el botón flotante de guardar. Para cerrar el editor, usa Guardar en el menú ⋯ o toca Atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer le bouton Enregistrer retire le bouton flottant d’enregistrement. Pour fermer l’éditeur, utilisez Enregistrer dans le menu ⋯ ou touchez Retour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजें बटन छिपाएँ तैरते हुए सहेजें बटन को हटा देता है। संपादक बंद करने के लिए ⋯ मेनू में सहेजें का उपयोग करें या वापस पर टैप करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Mentés gomb elrejtése eltávolítja a lebegő mentés gombot. A szerkesztő bezárásához használd a ⋯ menü Mentés parancsát, vagy koppints a Vissza gombra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi pulsante Salva rimuove il pulsante di salvataggio mobile. Per chiudere l’editor, usa Salva nel menu ⋯ o tocca Indietro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryj przycisk Zapisz usuwa pływający przycisk zapisu. Aby zamknąć edytor, użyj opcji Zapisz w menu ⋯ lub stuknij Wstecz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Скрыть кнопку „Сохранить“» убирает плавающую кнопку сохранения. Чтобы закрыть редактор, выберите «Сохранить» в меню ⋯ или нажмите «Назад»."
          }
        }
      }
    },
