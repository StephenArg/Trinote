          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर सहेजा गया। Trinote के अगली बार आपके सर्वर से कनेक्ट होने पर यह आपके जर्नल में जोड़ दिया जाएगा।"
