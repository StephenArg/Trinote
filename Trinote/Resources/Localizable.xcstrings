    "Creates a text note in your inbox, today's journal note, or at the top of the tree, and opens it in Trinote to edit." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ ملاحظة نصية في صندوق الوارد أو في ملاحظة يوميات اليوم أو في أعلى الشجرة، ويفتحها في Trinote لتحريرها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoří textovou poznámku v Doručených, v dnešní deníkové poznámce nebo na nejvyšší úrovni stromu a otevře ji v Trinote k úpravám."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt eine Textnotiz in deinem Eingang, in der heutigen Journalnotiz oder auf der obersten Ebene des Baums und öffnet sie in Trinote zum Bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates a text note in your inbox, today's journal note, or at the top of the tree, and opens it in Trinote to edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una nota de texto en tu bandeja de entrada, en la nota del diario de hoy o en la raíz del árbol, y la abre en Trinote para editarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée une note de texte dans votre boîte de réception, dans la note du journal d’aujourd’hui ou à la racine de l’arborescence, puis l’ouvre dans Trinote pour la modifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके इनबॉक्स, आज के जर्नल नोट या ट्री के शीर्ष पर एक टेक्स्ट नोट बनाता है और उसे संपादन के लिए Trinote में खोलता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szöveges jegyzetet hoz létre a Beérkezőkben, a mai naplójegyzetben vagy a fa legtetején, és megnyitja szerkesztésre a Trinote-ban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una nota di testo in In arrivo, nella nota del diario di oggi o nella radice dell’albero, e la apre in Trinote per modificarla."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy notatkę tekstową w skrzynce odbiorczej, w dzisiejszej notatce dziennika lub na najwyższym poziomie drzewa i otwiera ją w Trinote do edycji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаёт текстовую заметку во «Входящих», в сегодняшней заметке журнала или в корне дерева и открывает её в Trinote для редактирования."
          }
        }
      }
    },
