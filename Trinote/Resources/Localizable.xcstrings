          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите родителя"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر المجلد الأب"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल चुनें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szülő kiválasztása"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolit nadřazenou položku"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz element nadrzędny"
          }
        }
      }
    },
    "Choose where to move the note. Open folders, then tap a note to select it as the new parent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where to move the note. Open folders, then tap a note to select it as the new parent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde mover la nota. Abre carpetas y toca una nota para seleccionarla como nueva carpeta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli dove spostare la nota. Apri le cartelle, poi tocca una nota per selezionarla come nuovo genitore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où déplacer la note. Ouvrez des dossiers, puis touchez une note pour l’utiliser comme parent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, wohin die Notiz verschoben wird. Öffnen Sie Ordner und tippen Sie auf eine Notiz als neues übergeordnetes Element."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, куда переместить заметку. Откройте папки и нажмите заметку, чтобы сделать её новым родителем."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مكان نقل الملاحظة. افتح المجلدات، ثم انقر ملاحظة لاختيارها كأب جديد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट कहाँ ले जाना है चुनें। फ़ोल्डर खोलें, फिर नए मूल के रूप में चुनने के लिए किसी नोट पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, hova kerüljön a jegyzet. Nyisd meg a mappákat, majd koppints egy jegyzetre új szülőként."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, kam poznámku přesunout. Otevřete složky a klepněte na poznámku jako nového rodiče."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, dokąd przenieść notatkę. Otwórz foldery, a następnie stuknij notatkę, aby wybrać ją jako nowy element nadrzędny."
          }
        }
      }
    },
    "Choose where to place the duplicates. Use the tree to open folders, then tap a note to select it as the parent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where to place the duplicates. Use the tree to open folders, then tap a note to select it as the parent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde colocar los duplicados. Usa el árbol para abrir carpetas y toca una nota como carpeta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli dove mettere i duplicati. Usa l’albero per aprire le cartelle, poi tocca una nota come genitore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où placer les doublons. Utilisez l’arborescence pour ouvrir des dossiers, puis touchez une note comme parent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Ort für die Duplikate. Öffnen Sie im Baum Ordner und tippen Sie auf eine Notiz als übergeordnetes Element."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, куда поместить копии. Откройте папки в дереве и нажмите заметку как родителя."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مكان النسخ المكررة. استخدم الشجرة لفتح المجلدات، ثم انقر ملاحظة كأب."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डुप्लिकेट कहाँ रखें चुनें। फ़ोल्डर खोलने के लिए ट्री का उपयोग करें, फिर मूल के रूप में किसी नोट पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, hova kerüljenek a másolatok. A fában nyisd meg a mappákat, majd koppints egy jegyzetre szülőként."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, kam umístit duplicity. Ve stromu otevřete složky a klepněte na poznámku jako rodiče."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, gdzie umieścić duplikaty. Użyj drzewa, aby otworzyć foldery, a następnie stuknij notatkę jako element nadrzędny."
          }
        }
      }
    },
