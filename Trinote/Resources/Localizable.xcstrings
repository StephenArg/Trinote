    "Move “%@” under “%@”? The note will appear in the new location in the tree.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move “%@” under “%@”? The note will appear in the new location in the tree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Mover «%@» bajo «%@»? La nota aparecerá en la nueva ubicación en el árbol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostare «%@» sotto «%@»? La nota apparirà nella nuova posizione nell’albero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer « %@ » sous « %@ » ? La note apparaîtra au nouvel emplacement dans l’arborescence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ unter „%@“ verschieben? Die Notiz erscheint im Baum am neuen Ort."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить «%@» под «%@»? Заметка появится в дереве в новом месте."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل «%@» تحت «%@»؟ ستظهر الملاحظة في الموقع الجديد في الشجرة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» को «%@» के अंतर्गत ले जाएँ? नोट ट्री में नए स्थान पर दिखेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» áthelyezése «%@» alá? A jegyzet az új helyen jelenik meg a fában."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesunout „%@“ pod „%@“? Poznámka se ve stromu zobrazí na novém místě."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieść „%@” pod „%@”? Notatka pojawi się w drzewie w nowym miejscu."
          }
        }
      }
    },
