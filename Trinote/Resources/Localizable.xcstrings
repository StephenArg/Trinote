    "This restores the default accent theme, turns off custom app and tree colors, and resets every custom color to its default value." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد السمة الافتراضية ويلغي الألوان المخصصة ويعيد كل لون إلى افتراضه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnoví výchozí motiv akcentu, vypne vlastní barvy aplikace a stromu a obnoví výchozí hodnoty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt das Standard-Akzentthema wieder her, schaltet benutzerdefinierte App- und Baumfarben aus und setzt alle Farben zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This restores the default accent theme, turns off custom app and tree colors, and resets every custom color to its default value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura el tema de acento predeterminado, desactiva los colores personalizados de la app y del árbol, y restablece todos los colores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablit le thème d’accent par défaut, désactive les couleurs personnalisées et réinitialise chaque couleur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ॉल्ट एक्सेंट थीम पुनर्स्थापित करता है, कस्टम रंग बंद करता है और सभी रंग रीसेट करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visszaállítja az alapértelmezett kiemelést, kikapcsolja az egyéni színeket és visszaállítja azokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina il tema di accento predefinito, disattiva i colori personalizzati e reimposta ogni colore."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywraca domyślny motyw akcentu, wyłącza niestandardowe kolory i resetuje wszystkie kolory."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстанавливает тему акцента по умолчанию, отключает пользовательские цвета и сбрасывает все цвета."
          }
        }
      }
    },
    "This will delete “%@” and all its sub-notes. This cannot be undone easily." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف «%@» وجميع الملاحظات الفرعية. يصعب التراجع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaže „%@“ a všechny podřízené poznámky. Nelze snadno vrátit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht „%@“ und alle Unter-Notizen. Kann nur schwer rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete “%@” and all its sub-notes. This cannot be undone easily."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará «%@» y todas sus subnotas. No se puede deshacer fácilmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera « %@ » et toutes les sous-notes. Action difficilement réversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» और सभी उप-नोट हटा दिए जाएँगे। आसानी से पूर्ववत नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törli „%@” és az összes aljegyzetet. Nehezen vonható vissza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno eliminate «%@» e tutte le sottonote. Operazione difficilmente reversibile."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunie „%@” i wszystkie podnotatki. Trudno to cofnąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены «%@» и все подзаметки. Отменить будет сложно."
          }
        }
      }
    },
    "This will remove all locally cached notes, branches, and attributes for this server. Your data on the server is not affected." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل الملاحظات والفروع والسمات المخبأة محليًا. بيانات الخادم لا تتأثر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní lokálně uložené poznámky, větve a atributy. Data na serveru zůstanou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt lokal zwischengespeicherte Notizen, Zweige und Attribute. Serverdaten bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will remove all locally cached notes, branches, and attributes for this server. Your data on the server is not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará notas, ramas y atributos en caché locales. Los datos del servidor no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime le cache local (notes, branches, attributs). Les données sur le serveur ne sont pas affectées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सर्वर के लिए स्थानीय कैश नोट, शाखाएँ और विशेषताएँ हटा देगा। सर्वर डेटा सुरक्षित है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítja a helyi gyorsítótárazott jegyzeteket, ágakat és attribútumokat. A szerver adatai érintetlenek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove note, rami e attributi in cache locali. I dati sul server non sono toccati."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa lokalnie buforowane notatki, gałęzie i atrybuty. Dane na serwerze pozostają."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалит локально кэшированные заметки, ветки и атрибуты. Данные на сервере не затрагиваются."
          }
        }
      }
    },
    "This will remove the server profile and sign out. Your notes on the server will not be affected." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل ملف الخادم ويسجّل الخروج. ملاحظاتك على الخادم لا تتأثر."
          }
        },
        "cs" : {
