          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर सहेजा गया। Trinote में फिर से साइन इन करें, फिर यह आपके जर्नल में जोड़ दिया जाएगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
