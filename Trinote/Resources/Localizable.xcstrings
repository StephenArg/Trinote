        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato su questo dispositivo. Verrà aggiunto al tuo diario alla prossima connessione di Trinote al tuo server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisano na tym urządzeniu. Zostanie dodane do dziennika, gdy Trinote ponownie połączy się z Twoim serwerem."
          }
        },
        "ru" : {
          "stringUnit" : {
