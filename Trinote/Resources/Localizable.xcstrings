    "No matching lines in the loaded text (previews use plain text; very long notes may differ slightly from in-page find)." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد أسطر مطابقة في النص المحمّل (تستخدم المعاينات نصًا عاديًا؛ قد تختلف الملاحظات الطويلة جدًا قليلاً عن البحث داخل الصفحة)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V načteném textu nejsou žádné odpovídající řádky (náhledy používají prostý text; u velmi dlouhých poznámek se může výsledek mírně lišit od vyhledávání na stránce)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine passenden Zeilen im geladenen Text (Vorschauen nutzen Nur-Text; bei sehr langen Notizen kann es leichte Abweichungen zur Suche auf der Seite geben)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No matching lines in the loaded text (previews use plain text; very long notes may differ slightly from in-page find)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay líneas coincidentes en el texto cargado (las vistas previas usan texto sin formato; las notas muy largas pueden diferir ligeramente de la búsqueda en la página)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune ligne correspondante dans le texte chargé (les aperçus utilisent du texte brut ; les très longues notes peuvent différer légèrement de la recherche dans la page)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोड किए गए पाठ में कोई मिलान पंक्ति नहीं (पूर्वावलोकन सादा पाठ उपयोग करते हैं; बहुत लंबे नोट पृष्ठ-में खोज से थोड़ा भिन्न हो सकते हैं)।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs egyező sor a betöltött szövegben (az előnézetek sima szöveget használnak; nagyon hosszú jegyzeteknél apró eltérések lehetnek az oldalon belüli kereséshez képest)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna riga corrispondente nel testo caricato (le anteprime usano testo normale; note molto lunghe possono differire leggermente dalla ricerca nella pagina)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak pasujących linii w wczytanym tekście (podglądy używają zwykłego tekstu; przy bardzo długich notatkach mogą być drobne różnice względem wyszukiwania na stronie)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет совпадений в загруженном тексте (предпросмотры используют обычный текст; для очень длинных заметок возможны небольшие отличия от поиска на странице)."
          }
        }
      }
    },
