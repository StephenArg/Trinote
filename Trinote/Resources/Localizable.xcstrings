    "The card count turns red when the column holds more cards than its limit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card count turns red when the column holds more cards than its limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contador de tarjetas se vuelve rojo cuando la columna supera su límite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conteggio delle schede diventa rosso quando la colonna supera il suo limite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre de cartes devient rouge lorsque la colonne dépasse sa limite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kartenanzahl wird rot, wenn die Spalte mehr Karten als ihr Limit enthält."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счётчик карточек становится красным, когда в столбце больше карточек, чем позволяет лимит."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحول عدد البطاقات إلى الأحمر عندما يتجاوز العمود حده."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कॉलम में सीमा से अधिक कार्ड हों, तो कार्ड की गिनती लाल हो जाती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kártyaszám pirosra vált, ha az oszlopban több kártya van a korlátnál."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet karet zčervená, když sloupec obsahuje více karet, než je jeho limit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba kart zmienia kolor na czerwony, gdy kolumna przekracza swój limit."
          }
        }
      }
    },
