    "The card count turns red when the column holds more cards than its limit." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحول عدد البطاقات إلى الأحمر عندما يتجاوز العمود حده."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet karet zčervená, když sloupec obsahuje více karet, než je jeho limit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kartenanzahl wird rot, wenn die Spalte mehr Karten als ihr Limit enthält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The card count turns red when the column holds more cards than its limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contador de tarjetas se vuelve rojo cuando la columna supera su límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nombre de cartes devient rouge lorsque la colonne dépasse sa limite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कॉलम में सीमा से अधिक कार्ड हों, तो कार्ड की गिनती लाल हो जाती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kártyaszám pirosra vált, ha az oszlopban több kártya van a korlátnál."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il conteggio delle schede diventa rosso quando la colonna supera il suo limite."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba kart zmienia kolor na czerwony, gdy kolumna przekracza swój limit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счётчик карточек становится красным, когда в столбце больше карточек, чем позволяет лимит."
          }
        }
      }
    },
    "The file becomes the note itself, like a file note in Trilium." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح الملف هو الملاحظة نفسها، مثل ملاحظة الملف في Trilium."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor se stane samotnou poznámkou, jako souborová poznámka v Trilium."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wird selbst zur Notiz, wie eine Dateinotiz in Trilium."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file becomes the note itself, like a file note in Trilium."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se convierte en la propia nota, como una nota de archivo en Trilium."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier devient la note elle-même, comme une note fichier dans Trilium."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइल ही नोट बन जाती है, जैसे Trilium में फ़ाइल नोट।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fájl maga lesz a jegyzet, mint egy fájljegyzet a Triliumban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file diventa la nota stessa, come una nota file in Trilium."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik staje się samą notatką, jak notatka z plikiem w Trilium."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл сам становится заметкой, как заметка-файл в Trilium."
          }
        }
      }
    },
    "The file is attached to a new text note, where you can write around it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرفق الملف بملاحظة نصية جديدة، حيث يمكنك الكتابة حوله."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
