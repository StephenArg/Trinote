    "This restores the default accent theme, turns off custom app and tree colors, and resets every custom color to its default value.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This restores the default accent theme, turns off custom app and tree colors, and resets every custom color to its default value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el tema de acento predeterminado, desactiva los colores personalizados de la app y del árbol, y restablece todos los colores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina il tema di accento predefinito, disattiva i colori personalizzati e reimposta ogni colore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit le thème d’accent par défaut, désactive les couleurs personnalisées et réinitialise chaque couleur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt das Standard-Akzentthema wieder her, schaltet benutzerdefinierte App- und Baumfarben aus und setzt alle Farben zurück."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает тему акцента по умолчанию, отключает пользовательские цвета и сбрасывает все цвета."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد السمة الافتراضية ويلغي الألوان المخصصة ويعيد كل لون إلى افتراضه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट एक्सेंट थीम पुनर्स्थापित करता है, कस्टम रंग बंद करता है और सभी रंग रीसेट करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja az alapértelmezett kiemelést, kikapcsolja az egyéni színeket és visszaállítja azokat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví výchozí motiv akcentu, vypne vlastní barvy aplikace a stromu a obnoví výchozí hodnoty."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca domyślny motyw akcentu, wyłącza niestandardowe kolory i resetuje wszystkie kolory."
          }
        }
      }
    },
