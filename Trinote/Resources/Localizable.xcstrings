    "A note cannot be moved under itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A note cannot be moved under itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nota no puede moverse debajo de sí misma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nota non può essere spostata sotto se stessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une note ne peut pas être déplacée sous elle-même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Notiz kann nicht unter sich selbst verschoben werden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметку нельзя переместить под саму себя."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن نقل الملاحظة لتصبح تحت نفسها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी नोट को स्वयं के अंतर्गत नहीं ले जा सकते।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy jegyzet nem helyezhető önmaga alá."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámku nelze přesunout pod sebe samu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki nie można przenieść pod samą siebie."
          }
        }
      }
    },
