    "Switches to its dark version when Trinote is in dark mode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches to its dark version when Trinote is in dark mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a su versión oscura cuando Trinote está en modo oscuro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa alla versione scura quando Trinote è in modalità scura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe à sa version sombre lorsque Trinote est en mode sombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt zur dunklen Variante, wenn Trinote im Dunkelmodus ist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключается на тёмный вариант, когда Trinote в тёмном режиме."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحول إلى نسخته الداكنة عندما يكون Trinote في الوضع الداكن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinote के डार्क मोड में होने पर इसका डार्क संस्करण दिखता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sötét módban a Trinote a sötét változatára vált."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je Trinote v tmavém režimu, přepne se na tmavou verzi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącza się na wersję ciemną, gdy Trinote jest w trybie ciemnym."
          }
        }
      }
    },
