    "They download again when you open them. Keep them to only stop new downloads." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُنزَّل مرة أخرى عند فتحها. احتفظ بها لإيقاف التنزيلات الجديدة فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při otevření se znovu stáhnou. Ponechte je, pokud chcete jen zastavit nová stahování."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden beim Öffnen erneut heruntergeladen. Behalte sie, um nur neue Downloads zu stoppen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They download again when you open them. Keep them to only stop new downloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vuelven a descargar al abrirlos. Consérvalos para solo dejar de descargar nuevos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils se téléchargent de nouveau quand vous les ouvrez. Conservez-les pour seulement arrêter les nouveaux téléchargements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोलने पर वे फिर से डाउनलोड होंगी। केवल नए डाउनलोड रोकने के लिए उन्हें रखें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megnyitáskor újra letöltődnek. Tartsd meg őket, ha csak az új letöltéseket akarod leállítani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono scaricati di nuovo quando li apri. Conservali per fermare solo i nuovi download."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobiorą się ponownie po otwarciu. Zachowaj je, aby tylko wstrzymać nowe pobieranie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они снова загрузятся, когда вы их откроете. Оставьте их, чтобы только прекратить новые загрузки."
          }
        }
      }
    },
