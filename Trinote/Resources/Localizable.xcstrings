    "This will remove the server profile and sign out. Your notes on the server will not be affected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove the server profile and sign out. Your notes on the server will not be affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará el perfil del servidor y se cerrará sesión. Tus notas en el servidor no se verán afectadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove il profilo server e disconnette. Le note sul server non sono toccate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le profil serveur et déconnecte. Vos notes sur le serveur ne sont pas affectées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt das Serverprofil und meldet ab. Ihre Notizen auf dem Server bleiben unverändert."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалит профиль сервера и выйдет из аккаунта. Заметки на сервере не затрагиваются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل ملف الخادم ويسجّل الخروج. ملاحظاتك على الخادم لا تتأثر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर प्रोफ़ाइल हटाकर साइन आउट करेगा। सर्वर पर नोट प्रभावित नहीं होंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja a profilt és kijelentkezik. A szerveren lévő jegyzetek érintetlenek."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebere profil serveru a odhlásí. Poznámky na serveru zůstanou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunie profil serwera i wyloguje. Notatki na serwerze pozostaną."
          }
        }
      }
    },
