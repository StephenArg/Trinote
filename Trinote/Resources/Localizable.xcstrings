    "This will remove all locally cached notes, branches, and attributes for this server. Your data on the server is not affected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove all locally cached notes, branches, and attributes for this server. Your data on the server is not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará notas, ramas y atributos en caché locales. Los datos del servidor no se ven afectados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove note, rami e attributi in cache locali. I dati sul server non sono toccati."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le cache local (notes, branches, attributs). Les données sur le serveur ne sont pas affectées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt lokal zwischengespeicherte Notizen, Zweige und Attribute. Serverdaten bleiben unverändert."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалит локально кэшированные заметки, ветки и атрибуты. Данные на сервере не затрагиваются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الملاحظات والفروع والسمات المخبأة محليًا. بيانات الخادم لا تتأثر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सर्वर के लिए स्थानीय कैश नोट, शाखाएँ और विशेषताएँ हटा देगा। सर्वर डेटा सुरक्षित है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja a helyi gyorsítótárazott jegyzeteket, ágakat és attribútumokat. A szerver adatai érintetlenek."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní lokálně uložené poznámky, větve a atributy. Data na serveru zůstanou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa lokalnie buforowane notatki, gałęzie i atrybuty. Dane na serwerze pozostają."
          }
        }
      }
    },
