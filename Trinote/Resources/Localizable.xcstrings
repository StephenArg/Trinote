    },
    "Trinote didn't send this change because the note or attribute has an unexpected ID." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يرسل Trinote هذا التغيير لأن الملاحظة أو الخاصية لها معرّف غير متوقع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote tuto změnu neodeslal, protože poznámka nebo atribut má neočekávané ID."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote hat diese Änderung nicht gesendet, weil die Notiz oder das Attribut eine unerwartete ID hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote didn't send this change because the note or attribute has an unexpected ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote no envió este cambio porque la nota o el atributo tiene un ID inesperado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote n’a pas envoyé cette modification, car la note ou l’attribut a un identifiant inattendu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote ने यह बदलाव नहीं भेजा क्योंकि नोट या एट्रिब्यूट की ID अप्रत्याशित है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Trinote nem küldte el ezt a módosítást, mert a jegyzet vagy az attribútum azonosítója váratlan."
          }
        },
        "it" : {
          "stringUnit" : {
