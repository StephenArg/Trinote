            "value" : "सर्वर %@ में बदलाव की अनुमति नहीं देता, इसलिए आपके संपादन सहेजे नहीं गए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiszolgáló nem engedi módosítani ezt: %@, ezért a szerkesztéseid nem lettek mentve."
