          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server nepovoluje měnit %@, proto se vaše úpravy neuložily."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server erlaubt keine Änderungen an %@, daher wurden deine Bearbeitungen nicht gespeichert."
