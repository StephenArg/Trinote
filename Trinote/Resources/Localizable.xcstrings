    "Back Button Saves" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زر الرجوع يحفظ"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačítko Zpět ukládá"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück-Taste speichert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back Button Saves"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón Atrás guarda"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton Retour enregistre"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वापस बटन सहेजता है"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vissza gomb ment"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tasto Indietro salva"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycisk Wstecz zapisuje"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «Назад» сохраняет"
          }
        }
      }
    },
    "Back Button Saves saves the note when you tap Back while editing, instead of keeping a draft. On iPad it also saves when you open another note from the sidebar. Autosave always does this." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تفعيل «زر الرجوع يحفظ»، يؤدي الضغط على رجوع أثناء التحرير إلى حفظ الملاحظة بدلاً من الاحتفاظ بمسودة. على iPad تُحفظ أيضًا عند فتح ملاحظة أخرى من الشريط الجانبي. الحفظ التلقائي يفعل ذلك دائمًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zapnuto Tlačítko Zpět ukládá, klepnutí na Zpět během úprav poznámku uloží místo ponechání konceptu. Na iPadu se uloží také při otevření jiné poznámky z postranního panelu. Automatické ukládání to dělá vždy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Zurück-Taste speichert“ wird die Notiz beim Tippen auf Zurück während der Bearbeitung gespeichert, statt einen Entwurf zu behalten. Auf dem iPad wird sie auch gespeichert, wenn du eine andere Notiz in der Seitenleiste öffnest. Automatisch speichern macht das immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back Button Saves saves the note when you tap Back while editing, instead of keeping a draft. On iPad it also saves when you open another note from the sidebar. Autosave always does this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «El botón Atrás guarda», tocar Atrás mientras editas guarda la nota en lugar de conservar un borrador. En iPad también se guarda al abrir otra nota desde la barra lateral. El guardado automático siempre lo hace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec « Le bouton Retour enregistre », toucher Retour pendant la modification enregistre la note au lieu de garder un brouillon. Sur iPad, la note est aussi enregistrée quand vous ouvrez une autre note depuis la barre latérale. L’enregistrement automatique le fait toujours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वापस बटन सहेजता है चालू होने पर, संपादन के दौरान वापस टैप करने से ड्राफ़्ट रखने के बजाय नोट सहेजा जाता है। iPad पर साइडबार से कोई दूसरा नोट खोलने पर भी यह सहेजा जाता है। ऑटोसेव हमेशा ऐसा करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vissza gomb ment beállítással szerkesztés közben a Vissza gomb megérintése piszkozat megtartása helyett menti a jegyzetet. iPaden akkor is ment, ha az oldalsávból másik jegyzetet nyitsz meg. Az automatikus mentés ezt mindig megteszi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Il tasto Indietro salva», toccare Indietro durante la modifica salva la nota invece di conservare una bozza. Su iPad la nota viene salvata anche quando apri un’altra nota dalla barra laterale. Il salvataggio automatico lo fa sempre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączona jest opcja Przycisk Wstecz zapisuje, stuknięcie Wstecz podczas edycji zapisuje notatkę zamiast zachowywać szkic. Na iPadzie notatka zapisuje się też po otwarciu innej notatki z paska bocznego. Autozapis robi to zawsze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, нажатие «Назад» во время редактирования сохраняет заметку, а не оставляет черновик. На iPad заметка также сохраняется, когда вы открываете другую заметку на боковой панели. Автосохранение делает это всегда."
          }
        }
      }
    },
