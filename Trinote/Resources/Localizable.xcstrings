        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido de la nota se leerá como texto con formato, así que los saltos de línea y los espacios pueden perderse la próxima vez que la guardes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu de la note sera lu comme du texte mis en forme : les retours à la ligne et les espaces peuvent être perdus au prochain enregistrement."
