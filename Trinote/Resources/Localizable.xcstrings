    "Saved on this device. It will be added to your journal when Trinote next connects to your server." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الحفظ على هذا الجهاز. ستتم إضافته إلى يومياتك عند اتصال Trinote التالي بالخادم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloženo v tomto zařízení. Do deníku se přidá, až se Trinote znovu připojí k vašemu serveru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät gespeichert. Es wird zu deinem Journal hinzugefügt, sobald Trinote wieder mit deinem Server verbunden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved on this device. It will be added to your journal when Trinote next connects to your server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado en este dispositivo. Se añadirá a tu diario cuando Trinote vuelva a conectarse a tu servidor."
          }
