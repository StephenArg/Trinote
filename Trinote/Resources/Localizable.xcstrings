    "Permanently delete %lld note(s) and all of their sub-notes? This cannot be undone easily." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف %lld ملاحظة وجميع الملاحظات الفرعية نهائيًا؟ يصعب التراجع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvale smazat %lld poznámek a všechny podřízené? Nelze snadno vrátit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Notiz(en) und alle Unter-Notizen dauerhaft löschen? Kann nur schwer rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently delete %lld note(s) and all of their sub-notes? This cannot be undone easily."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar permanentemente %lld nota(s) y todas sus subnotas? No se puede deshacer fácilmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer définitivement %lld note(s) et toutes les sous-notes ? Action difficilement réversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld नोट और सभी उप-नोट स्थायी रूप से हटाएँ? आसानी से पूर्ववत नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld jegyzet és az összes aljegyzet végleges törlése? Nehezen vonható vissza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare definitivamente %lld nota(e) e tutte le sottonote? Operazione difficilmente reversibile."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwale usunąć %lld notatek i wszystkie podnotatki? Trudno cofnąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безвозвратно удалить %lld заметок и все подзаметки? Отменить будет сложно."
          }
        }
      }
    },
