    "Enter the same document password you use in Trilium for protected notes. It stays active until you sign out or the server ends the session." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل نفس كلمة مرور المستند كما في Trilium. تبقى نشطة حتى تسجيل الخروج أو انتهاء الجلسة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte stejné heslo dokumentu jako v Trilium. Platné do odhlášení nebo ukončení relace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie dasselbe Dokumentpasswort wie in Trilium ein. Gültig bis Abmeldung oder Sitzungsende."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the same document password you use in Trilium for protected notes. It stays active until you sign out or the server ends the session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la misma contraseña de documento que en Trilium. Permanece activa hasta cerrar sesión o hasta que el servidor cierre la sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le même mot de passe document que dans Trilium. Actif jusqu’à déconnexion ou fin de session serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trilium में जैसा दस्तावेज़ पासवर्ड वही दर्ज करें। साइन आउट या सत्र समाप्ति तक सक्रिय।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adja meg ugyanazt a dokumentum jelszót, mint a Triliumban. Aktív marad kijelentkezésig vagy a munkamenet végéig."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la stessa password documento di Trilium. Resta attiva fino al logout o alla fine sessione server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz to samo hasło dokumentu co w Trilium. Aktywne do wylogowania lub zakończenia sesji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите тот же пароль документа, что в Trilium. Действует до выхода или завершения сессии."
          }
        }
      }
