    "Trilium keeps the note's content when its type changes, but not every type can show content from another." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ Trilium بمحتوى الملاحظة عند تغيير نوعها، لكن ليس كل نوع يستطيع عرض محتوى نوع آخر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trilium při změně typu obsah poznámky zachová, ale ne každý typ dokáže zobrazit obsah jiného."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trilium behält den Inhalt der Notiz, wenn sich ihr Typ ändert, aber nicht jeder Typ kann den Inhalt eines anderen anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trilium keeps the note's content when its type changes, but not every type can show content from another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trilium conserva el contenido de la nota al cambiar su tipo, pero no todos los tipos pueden mostrar el contenido de otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trilium conserve le contenu de la note quand son type change, mais tous les types ne peuvent pas afficher le contenu d’un autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रकार बदलने पर Trilium नोट की सामग्री रखता है, लेकिन हर प्रकार दूसरे प्रकार की सामग्री नहीं दिखा सकता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Trilium megtartja a jegyzet tartalmát, ha a típusa megváltozik, de nem minden típus tudja megjeleníteni egy másik tartalmát."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trilium conserva il contenuto della nota quando ne cambi il tipo, ma non tutti i tipi possono mostrare il contenuto di un altro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trilium zachowuje treść notatki przy zmianie typu, ale nie każdy typ potrafi pokazać treść innego."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trilium сохраняет содержимое заметки при смене типа, но не каждый тип может показать содержимое другого."
          }
        }
      }
    },
