    "Allow Trinote to use your location in Settings to show where you are on the map.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Trinote to use your location in Settings to show where you are on the map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Trinote use tu ubicación en Ajustes para mostrar dónde estás en el mapa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Trinote di usare la tua posizione in Impostazioni per mostrare dove ti trovi sulla mappa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Trinote à utiliser votre position dans Réglages pour afficher où vous êtes sur la carte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie Trinote in den Einstellungen, Ihren Standort zu verwenden, damit angezeigt wird, wo Sie sich auf der Karte befinden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Trinote использовать вашу геопозицию в Настройках, чтобы показать, где вы на карте."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ Trinote باستخدام موقعك من الإعدادات لإظهار مكانك على الخريطة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मानचित्र पर आपकी जगह दिखाने के लिए सेटिंग्स में Trinote को आपका स्थान उपयोग करने की अनुमति दें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Beállításokban, hogy a Trinote használja a helyzetedet, így megmutathatja, hol vagy a térképen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Nastavení povolte aplikaci Trinote používat vaši polohu, aby mohla ukázat, kde na mapě jste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól w Ustawieniach, aby Trinote używał Twojej lokalizacji i pokazywał, gdzie jesteś na mapie."
          }
        }
      }
    },
