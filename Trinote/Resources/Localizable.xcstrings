    "AI chat needs Trilium %1$@ or newer; this server runs %2$@." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب دردشة الذكاء الاصطناعي Trilium %1$@ أو أحدث؛ يعمل هذا الخادم بالإصدار %2$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI chat vyžaduje Trilium %1$@ nebo novější; tento server používá %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der KI-Chat braucht Trilium %1$@ oder neuer; dieser Server läuft mit %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI chat needs Trilium %1$@ or newer; this server runs %2$@."
