    "Chats stay in Trilium's hidden AI Chat History folder until you keep one." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الدردشات في مجلد سجل دردشات الذكاء الاصطناعي المخفي في Trilium حتى تحتفظ بإحداها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaty zůstávají ve skryté složce Historie AI chatů v Triliu, dokud některý neponecháte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats bleiben in Triliums verborgenem Ordner KI-Chat-Verlauf, bis du einen behältst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats stay in Trilium's hidden AI Chat History folder until you keep one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los chats permanecen en la carpeta oculta Historial de chat de IA de Trilium hasta que conserves uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chats restent dans le dossier masqué Historique des chats IA de Trilium jusqu’à ce que vous en conserviez un."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैट Trilium के छिपे हुए AI चैट इतिहास फ़ोल्डर में रहती हैं जब तक आप किसी को रखते नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csevegések a Trilium rejtett AI-csevegés előzmények mappájában maradnak, amíg meg nem tartasz egyet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chat restano nella cartella nascosta Cronologia chat IA di Trilium finché non ne conservi una."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czaty pozostają w ukrytym folderze Historia czatów AI w Trilium, dopóki któregoś nie zachowasz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чаты остаются в скрытой папке «История ИИ-чатов» Trilium, пока вы не сохраните один из них."
          }
        }
      }
