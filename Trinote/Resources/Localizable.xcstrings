    "A %@ note can't show the note's current content. It will be replaced the next time you save the note." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لملاحظة من نوع %@ عرض المحتوى الحالي للملاحظة. سيُستبدل عند حفظ الملاحظة في المرة القادمة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka typu %@ nedokáže zobrazit současný obsah poznámky. Při příštím uložení poznámky bude nahrazen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Notiz vom Typ %@ kann den aktuellen Inhalt der Notiz nicht anzeigen. Er wird beim nächsten Speichern ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ note can't show the note's current content. It will be replaced the next time you save the note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota de tipo %@ no puede mostrar el contenido actual de la nota. Se reemplazará la próxima vez que guardes la nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note de type %@ ne peut pas afficher le contenu actuel de la note. Il sera remplacé au prochain enregistrement de la note."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ नोट इस नोट की मौजूदा सामग्री नहीं दिखा सकता। अगली बार नोट सहेजने पर इसे बदल दिया जाएगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ típusú jegyzet nem tudja megjeleníteni a jegyzet jelenlegi tartalmát. A következő mentéskor lecserélődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota di tipo %@ non può mostrare il contenuto attuale della nota. Verrà sostituito al prossimo salvataggio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notatka typu %@ nie może pokazać obecnej treści notatki. Zostanie ona zastąpiona przy następnym zapisie notatki."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметка типа «%@» не может показать текущее содержимое. Оно будет заменено при следующем сохранении заметки."
          }
        }
      }
    },
    "A %@ note doesn't show the content. It stays in the note and comes back if you change the type back." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة من نوع %@ لا تعرض المحتوى. يبقى في الملاحظة ويعود إذا أعدت النوع كما كان."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka typu %@ obsah nezobrazuje. Zůstane v poznámce a vrátí se, když typ změníte zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Notiz vom Typ %@ zeigt den Inhalt nicht an. Er bleibt in der Notiz und erscheint wieder, wenn du den Typ zurückänderst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ note doesn't show the content. It stays in the note and comes back if you change the type back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota de tipo %@ no muestra el contenido. Se queda en la nota y vuelve si cambias el tipo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note de type %@ n’affiche pas le contenu. Il reste dans la note et réapparaît si vous rétablissez le type."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ नोट सामग्री नहीं दिखाता। यह नोट में रहती है और प्रकार वापस बदलने पर लौट आती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ típusú jegyzet nem jeleníti meg a tartalmat. Az a jegyzetben marad, és visszatér, ha visszaállítod a típust."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota di tipo %@ non mostra il contenuto. Rimane nella nota e ricompare se ripristini il tipo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notatka typu %@ nie pokazuje treści. Zostaje ona w notatce i wróci, jeśli przywrócisz typ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметка типа «%@» не показывает содержимое. Оно остаётся в заметке и вернётся, если снова сменить тип."
          }
        }
      }
    },
    "A collection shows its child notes. The view is saved as the note's #viewType label." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض المجموعة ملاحظاتها الفرعية. يُحفظ العرض في تسمية #viewType للملاحظة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolekce zobrazuje své podřízené poznámky. Zobrazení se uloží jako štítek #viewType poznámky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sammlung zeigt ihre Unternotizen. Die Ansicht wird im Label #viewType der Notiz gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A collection shows its child notes. The view is saved as the note's #viewType label."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una colección muestra sus notas hijas. La vista se guarda como la etiqueta #viewType de la nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une collection affiche ses notes enfants. La vue est enregistrée dans l’étiquette #viewType de la note."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कलेक्शन अपने चाइल्ड नोट दिखाता है। व्यू नोट के #viewType लेबल में सहेजा जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gyűjtemény a gyermekjegyzeteit mutatja. A nézet a jegyzet #viewType címkéjében tárolódik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una raccolta mostra le sue note figlie. La vista viene salvata come etichetta #viewType della nota."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolekcja pokazuje swoje notatki podrzędne. Widok jest zapisywany jako etykieta #viewType notatki."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коллекция показывает дочерние заметки. Вид сохраняется в метке #viewType заметки."
          }
        }
      }
    },
    "A completed state checks the box and strikes the item through. A hidden state still shows in notes but can't be picked." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحالة المكتملة تحدد المربع وتشطب العنصر. الحالة المخفية تبقى ظاهرة في الملاحظات لكن لا يمكن اختيارها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokončený stav zaškrtne pole a položku přeškrtne. Skrytý stav se v poznámkách dál zobrazuje, ale nelze ho vybrat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein erledigter Status hakt das Kästchen ab und streicht den Eintrag durch. Ein ausgeblendeter Status ist in Notizen weiter sichtbar, kann aber nicht gewählt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A completed state checks the box and strikes the item through. A hidden state still shows in notes but can't be picked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un estado completado marca la casilla y tacha el elemento. Un estado oculto se sigue viendo en las notas, pero no se puede elegir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un état terminé coche la case et barre l'élément. Un état masqué reste visible dans les notes mais ne peut pas être choisi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूर्ण स्थिति बॉक्स पर निशान लगाती है और आइटम को काट देती है। छिपी स्थिति नोट्स में दिखती रहती है, पर चुनी नहीं जा सकती।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A befejezett állapot bejelöli a négyzetet és áthúzza az elemet. A rejtett állapot továbbra is látszik a jegyzetekben, de nem választható."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno stato completato spunta la casella e barra l'elemento. Uno stato nascosto resta visibile nelle note ma non si può scegliere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stan ukończony zaznacza pole i przekreśla element. Stan ukryty nadal widać w notatkach, ale nie można go wybrać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполненное состояние отмечает флажок и зачёркивает пункт. Скрытое состояние по-прежнему видно в заметках, но выбрать его нельзя."
          }
        }
      }
    },
    "A note cannot be moved under itself." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن نقل الملاحظة لتصبح تحت نفسها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámku nelze přesunout pod sebe samu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Notiz kann nicht unter sich selbst verschoben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A note cannot be moved under itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota no puede moverse debajo de sí misma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note ne peut pas être déplacée sous elle-même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी नोट को स्वयं के अंतर्गत नहीं ले जा सकते।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy jegyzet nem helyezhető önmaga alá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota non può essere spostata sotto se stessa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notatki nie można przenieść pod samą siebie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметку нельзя переместить под саму себя."
          }
        }
      }
    },
    "A tap toggles between None and this state; an item that counts as completed goes back to None. Hold a checkbox to pick any state. This choice is kept on this device." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النقر يبدّل بين «لا شيء» وهذه الحالة؛ والعنصر الذي يُعدّ مكتملًا يعود إلى «لا شيء». اضغط مطولًا على مربع اختيار لاختيار أي حالة. يُحفظ هذا الاختيار على هذا الجهاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutí přepíná mezi Žádný a tímto stavem; položka, která se počítá jako dokončená, se vrátí na Žádný. Podržením zaškrtávacího pole vyberete libovolný stav. Tato volba zůstává v tomto zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tippen wechselt zwischen „Keiner“ und diesem Status; ein Eintrag, der als erledigt zählt, wird wieder „Keiner“. Halte ein Kästchen gedrückt, um einen beliebigen Status zu wählen. Diese Wahl bleibt auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tap toggles between None and this state; an item that counts as completed goes back to None. Hold a checkbox to pick any state. This choice is kept on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un toque alterna entre Ninguno y este estado; un elemento que cuenta como completado vuelve a Ninguno. Mantén pulsada una casilla para elegir cualquier estado. Esta opción se guarda en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un toucher bascule entre Aucun et cet état ; un élément considéré comme terminé revient à Aucun. Maintenez une case pour choisir n'importe quel état. Ce choix est conservé sur cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टैप करने से कोई नहीं और इस स्थिति के बीच बदलाव होता है; पूर्ण मानी जाने वाली आइटम वापस कोई नहीं पर जाती है। कोई भी स्थिति चुनने के लिए चेकबॉक्स को दबाकर रखें। यह विकल्प इसी डिवाइस पर रहता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A koppintás a Nincs és ez az állapot között vált; a befejezettnek számító elem visszakerül Nincs állapotba. Bármely állapot választásához tartsd lenyomva a jelölőnégyzetet. Ez a beállítás ezen az eszközön marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tocco alterna tra Nessuno e questo stato; un elemento che conta come completato torna a Nessuno. Tieni premuta una casella per scegliere qualsiasi stato. Questa scelta resta su questo dispositivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknięcie przełącza między Brak a tym stanem; element liczony jako ukończony wraca do Brak. Przytrzymaj pole, aby wybrać dowolny stan. Ten wybór jest zapisany na tym urządzeniu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Касание переключает между «Нет» и этим состоянием; пункт, который считается выполненным, возвращается к «Нет». Удерживайте флажок, чтобы выбрать любое состояние. Этот выбор хранится на этом устройстве."
          }
        }
      }
    },
