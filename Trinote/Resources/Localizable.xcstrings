    "Trinote couldn't read the note's content to check it. If a %@ note can't show it, it will be replaced the next time you save the note." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Trinote قراءة محتوى الملاحظة للتحقق منه. إذا لم تتمكن ملاحظة من نوع %@ من عرضه، فسيُستبدل عند حفظ الملاحظة في المرة القادمة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote nemohl načíst obsah poznámky ke kontrole. Pokud ho poznámka typu %@ nedokáže zobrazit, při příštím uložení bude nahrazen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote konnte den Inhalt der Notiz nicht zur Prüfung lesen. Wenn eine Notiz vom Typ %@ ihn nicht anzeigen kann, wird er beim nächsten Speichern ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote couldn't read the note's content to check it. If a %@ note can't show it, it will be replaced the next time you save the note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote no pudo leer el contenido de la nota para comprobarlo. Si una nota de tipo %@ no puede mostrarlo, se reemplazará la próxima vez que guardes la nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote n’a pas pu lire le contenu de la note pour le vérifier. Si une note de type %@ ne peut pas l’afficher, il sera remplacé au prochain enregistrement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote जाँच के लिए नोट की सामग्री नहीं पढ़ सका। अगर %@ नोट इसे नहीं दिखा सकता, तो अगली बार नोट सहेजने पर इसे बदल दिया जाएगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Trinote nem tudta beolvasni a jegyzet tartalmát az ellenőrzéshez. Ha a(z) %@ típusú jegyzet nem tudja megjeleníteni, a következő mentéskor lecserélődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote non è riuscito a leggere il contenuto della nota per controllarlo. Se una nota di tipo %@ non può mostrarlo, verrà sostituito al prossimo salvataggio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote nie mógł odczytać treści notatki, aby ją sprawdzić. Jeśli notatka typu %@ nie może jej pokazać, zostanie ona zastąpiona przy następnym zapisie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinote не удалось прочитать содержимое заметки для проверки. Если заметка типа «%@» не сможет его показать, оно будет заменено при следующем сохранении."
          }
        }
      }
    },
    "Trinote didn't finish starting. Try again." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يكتمل تشغيل Trinote. حاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
