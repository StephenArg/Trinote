    "Saved on this device. Your edit will upload when you're back online.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved on this device. Your edit will upload when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en este dispositivo. La edición se subirá cuando vuelvas a estar en línea."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato su questo dispositivo. La modifica verrà caricata quando tornerai online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré sur cet appareil. Votre modification sera envoyée lorsque vous serez de nouveau en ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät gespeichert. Ihre Bearbeitung wird hochgeladen, sobald Sie wieder online sind."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено на этом устройстве. Изменение загрузится, когда вы снова будете в сети."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ على هذا الجهاز. سيتم رفع التعديل عند عودة الاتصال."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर सहेजा गया। ऑनलाइन होने पर आपका संपादन अपलोड होगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentve ezen az eszközön. A szerkesztés feltöltődik, ha újra online leszel."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo v tomto zařízení. Úpravy se nahrají, až budete znovu online."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano na tym urządzeniu. Edycja zostanie wysłana po ponownym połączeniu z siecią."
          }
        }
      }
    },
