    "Share a note from its details panel to see it here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share a note from its details panel to see it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte una nota desde su panel de detalles para verla aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi una nota dal pannello dettagli per vederla qui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez une note depuis son panneau de détails pour la voir ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie eine Notiz über das Detailfenster, um sie hier zu sehen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь заметкой из панели сведений, чтобы она появилась здесь."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارِك ملاحظة من لوحة التفاصيل لعرضها هنا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे यहाँ देखने के लिए विवरण पैनल से किसी नोट को साझा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Osszon meg egy jegyzetet a részletek panelről, hogy itt megjelenjen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílejte poznámku z panelu podrobností, aby se zobrazila zde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij notatkę z panelu szczegółów, aby pojawiła się tutaj."
          }
        }
      }
    },
