            "value" : "Saved on this device. Sign in again in Trinote and it will be added to your journal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado en este dispositivo. Vuelve a iniciar sesión en Trinote y se añadirá a tu diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
