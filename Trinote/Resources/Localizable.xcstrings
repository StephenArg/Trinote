    "Long-press a note in the tree and choose “Add to Favorites” to add it here." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على ملاحظة في الشجرة واختر «إضافة إلى المفضلة»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dlouze stiskněte poznámku ve stromu a zvolte „Přidat do oblíbených“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie eine Notiz im Baum gedrückt und wählen Sie „Zu Favoriten hinzufügen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-press a note in the tree and choose “Add to Favorites” to add it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada una nota en el árbol y elige «Añadir a favoritos» para añadirla aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur une note dans l’arborescence et choisissez « Ajouter aux favoris »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्री में नोट पर देर तक दबाएँ और «पसंदीदा में जोड़ें» चुनें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyomja hosszan a jegyzetet a fában, majd válassza a „Kedvencekhez adás” lehetőséget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta una nota nell’albero e scegli «Aggiungi ai preferiti»."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj notatkę w drzewie i wybierz „Dodaj do ulubionych”, aby dodać ją tutaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Долго нажмите заметку в дереве и выберите «В избранное»."
          }
        }
      }
    },
