    "This note sorts its sub-notes automatically (#sorted), so they can’t be reordered by hand." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتّب هذه الملاحظة ملاحظاتها الفرعية تلقائيًا (#sorted)، لذا لا يمكن إعادة ترتيبها يدويًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato poznámka řadí podřízené poznámky automaticky (#sorted), takže je nelze přeřadit ručně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Notiz sortiert ihre Unter-Notizen automatisch (#sorted), daher lassen sie sich nicht von Hand neu anordnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This note sorts its sub-notes automatically (#sorted), so they can’t be reordered by hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta nota ordena sus subnotas automáticamente (#sorted), así que no se pueden reordenar a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette note trie ses sous-notes automatiquement (#sorted) : elles ne peuvent pas être réorganisées à la main."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह नोट अपने उप-नोट्स को अपने आप क्रमबद्ध करता है (#sorted), इसलिए उनका क्रम हाथ से नहीं बदला जा सकता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a jegyzet automatikusan rendezi az aljegyzeteit (#sorted), ezért kézzel nem rendezhetők át."
