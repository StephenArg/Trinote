    "This will delete “%@” and all its sub-notes. This cannot be undone easily.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete “%@” and all its sub-notes. This cannot be undone easily."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará «%@» y todas sus subnotas. No se puede deshacer fácilmente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminate «%@» e tutte le sottonote. Operazione difficilmente reversibile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera « %@ » et toutes les sous-notes. Action difficilement réversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht „%@“ und alle Unter-Notizen. Kann nur schwer rückgängig gemacht werden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут удалены «%@» и все подзаметки. Отменить будет сложно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف «%@» وجميع الملاحظات الفرعية. يصعب التراجع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» और सभी उप-नोट हटा दिए जाएँगे। आसानी से पूर्ववत नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli „%@” és az összes aljegyzetet. Nehezen vonható vissza."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže „%@“ a všechny podřízené poznámky. Nelze snadno vrátit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunie „%@” i wszystkie podnotatki. Trudno to cofnąć."
          }
        }
      }
    },
