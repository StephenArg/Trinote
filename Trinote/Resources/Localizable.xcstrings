    "Cannot change sharing while offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot change sharing while offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar el uso compartido sin conexión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile modificare la condivisione senza connessione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier le partage hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigabe kann offline nicht geändert werden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельзя изменить общий доступ в автономном режиме."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تغيير المشاركة دون اتصال."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन रहते हुए साझाकरण नहीं बदला जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megosztás offline nem módosítható."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílení nelze offline změnit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zmienić udostępniania w trybie offline."
          }
        }
      }
    },
