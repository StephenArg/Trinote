    "Names can only hold letters, numbers, _ and :." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن تحتوي الأسماء على الحروف والأرقام و_ و: فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Názvy mohou obsahovat jen písmena, číslice, _ a :."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen dürfen nur Buchstaben, Ziffern, _ und : enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names can only hold letters, numbers, _ and :."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres solo pueden tener letras, números, _ y :."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms ne peuvent contenir que des lettres, des chiffres, _ et :."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नामों में केवल अक्षर, अंक, _ और : हो सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nevek csak betűket, számokat, _ és : karaktert tartalmazhatnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi possono contenere solo lettere, numeri, _ e :."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwy mogą zawierać tylko litery, cyfry, _ i :."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имена могут содержать только буквы, цифры, _ и :."
          }
        }
      }
    },
