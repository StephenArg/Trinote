    "–" : {
      "comment" : "A separator between the match and the preview line.",
      "isCommentAutoGenerated" : true
    },
    "“%@” and all its subnotes will be permanently deleted. This cannot be undone." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف «%@» وجميع الملاحظات الفرعية نهائيًا. لا يمكن التراجع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ a všechny podřízené poznámky budou trvale smazány. Nelze vrátit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und alle Unter-Notizen werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” and all its subnotes will be permanently deleted. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» y todas sus subnotas se eliminarán permanentemente. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et toutes les sous-notes seront supprimées définitivement. Action irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» और सभी उप-नोट स्थायी रूप से हटा दिए जाएँगे। पूर्ववत नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” és az összes aljegyzet véglegesen törlődik. Nem vonható vissza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» e tutte le sottonote verranno eliminate in modo permanente. Operazione irreversibile."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” i wszystkie podnotatki zostaną trwale usunięte. Tego nie cofniesz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» и все подзаметки будут безвозвратно удалены. Это нельзя отменить."
          }
        }
      }
    },
    "“%@” is also cloned elsewhere in the tree. Removing it from the board keeps those clones." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» منسوخة أيضًا في مكان آخر من الشجرة. إزالتها من اللوحة تُبقي تلك النسخ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ je naklonována i jinde ve stromu. Po odebrání z tabule tyto klony zůstanou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist auch an anderer Stelle im Baum geklont. Beim Entfernen vom Board bleiben diese Klone erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is also cloned elsewhere in the tree. Removing it from the board keeps those clones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» también está clonada en otra parte del árbol. Quitarla del tablero conserva esos clones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est aussi clonée ailleurs dans l’arborescence. La retirer du tableau conserve ces clones."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ट्री में कहीं और भी क्लोन है। इसे बोर्ड से हटाने पर वे क्लोन बने रहते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” a fában máshol is klónozva van. Ha eltávolítod a tábláról, azok a klónok megmaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è clonata anche altrove nell’albero. Toglierla dalla bacheca mantiene quei cloni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” jest sklonowana także w innym miejscu drzewa. Usunięcie jej z tablicy zachowa te klony."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» также клонирована в другие места дерева. Если убрать её с доски, эти клоны останутся."
          }
        }
      }
    },
