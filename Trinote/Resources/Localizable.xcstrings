    "Visitors to the shared page will need the new password; the old one stops working." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيحتاج زوار الصفحة المشتركة إلى كلمة المرور الجديدة؛ وستتوقف القديمة عن العمل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Návštěvníci sdílené stránky budou potřebovat nové heslo; staré přestane fungovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besucher der geteilten Seite brauchen das neue Passwort; das alte funktioniert nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visitors to the shared page will need the new password; the old one stops working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los visitantes de la página compartida necesitarán la nueva contraseña; la anterior dejará de funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les visiteurs de la page partagée auront besoin du nouveau mot de passe ; l’ancien ne fonctionnera plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा पेज के विज़िटर को नया पासवर्ड चाहिए होगा; पुराना काम करना बंद कर देगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megosztott oldal látogatóinak az új jelszó kell; a régi nem működik tovább."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I visitatori della pagina condivisa avranno bisogno della nuova password; quella vecchia smetterà di funzionare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odwiedzający udostępnioną stronę będą potrzebować nowego hasła; stare przestanie działać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посетителям опубликованной страницы понадобится новый пароль; старый перестанет работать."
          }
        }
      }
    },
    "Visitors to the shared page won't need this password any more." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يحتاج زوار الصفحة المشتركة إلى كلمة المرور هذه بعد الآن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Návštěvníci sdílené stránky už toto heslo nebudou potřebovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besucher der geteilten Seite brauchen dieses Passwort dann nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visitors to the shared page won't need this password any more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los visitantes de la página compartida ya no necesitarán esta contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les visiteurs de la page partagée n’auront plus besoin de ce mot de passe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा पेज के विज़िटर को अब इस पासवर्ड की ज़रूरत नहीं होगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megosztott oldal látogatóinak többé nem kell ez a jelszó."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I visitatori della pagina condivisa non avranno più bisogno di questa password."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odwiedzający udostępnioną stronę nie będą już potrzebować tego hasła."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посетителям опубликованной страницы больше не понадобится этот пароль."
          }
        }
      }
    },
