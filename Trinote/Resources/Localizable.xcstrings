    "Choose Parent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Parent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir carpeta"
          }
        },
        "it": {
          "stringUnit": {
