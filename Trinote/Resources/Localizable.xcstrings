    "Can't attach “%@”: only images, PDF files and text files can be sent." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إرفاق «%@»: يمكن إرسال الصور وملفات PDF والملفات النصية فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ nelze připojit: odeslat lze jen obrázky, soubory PDF a textové soubory."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht angehängt werden: Nur Bilder, PDF- und Textdateien können gesendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't attach “%@”: only images, PDF files and text files can be sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede adjuntar «%@»: solo se pueden enviar imágenes, archivos PDF y archivos de texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre « %@ » : seuls les images, les fichiers PDF et les fichiers texte peuvent être envoyés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
