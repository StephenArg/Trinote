    "Still trying to reach the server. Check the address and that your server is online." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما زلنا نحاول الوصول إلى الخادم. تحقق من العنوان ومن أن الخادم متصل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stále se pokoušíme spojit se serverem. Zkontrolujte adresu a zda je server online."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server wird weiterhin gesucht. Prüfe die Adresse und ob dein Server online ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still trying to reach the server. Check the address and that your server is online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguimos intentando conectar con el servidor. Comprueba la dirección y que el servidor esté en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tentative de connexion au serveur toujours en cours. Vérifiez l’adresse et que votre serveur est en ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी भी सर्वर से संपर्क की कोशिश जारी है। पता जाँचें और देखें कि सर्वर ऑनलाइन है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még mindig próbáljuk elérni a kiszolgálót. Ellenőrizd a címet, és hogy a kiszolgáló elérhető-e."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiamo ancora cercando di raggiungere il server. Controlla l’indirizzo e che il server sia online."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal próbujemy połączyć się z serwerem. Sprawdź adres i czy serwer jest online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё ещё пытаемся связаться с сервером. Проверьте адрес и что сервер в сети."
          }
        }
      }
    },
